[
  {
    "id": "flow_tab_sensors",
    "type": "tab",
    "label": "Умный офис",
    "disabled": false,
    "info": "Температура задаётся вручную: двойной клик по узлу «Температура, °C (повтор 5 с)», вписать число, Done, Deploy. Введённое значение повторяется каждые 5 секунд (случайности нет) и уходит показанием TEMP-01 в CTRL-01 (:8080) и БД-01 (:8081). То же значение идёт в switch: выше 30 °C — ON, иначе OFF; узел «только при изменении» пропускает событие вентилятора лишь при смене состояния, чтобы не засорять базу. Влажность HUM-01 формируется автоматически каждые 5 с."
  },
  {
    "id": "inj_temp",
    "type": "inject",
    "z": "flow_tab_sensors",
    "name": "Температура, °C (повтор 5 с)",
    "props": [
      {
        "p": "payload",
        "v": "35",
        "vt": "num"
      },
      {
        "p": "timestamp",
        "v": "",
        "vt": "date"
      }
    ],
    "repeat": "5",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
    "topic": "",
    "x": 170,
    "y": 160,
    "wires": [
      [
        "chg_temp",
        "sw_fan"
      ]
    ]
  },
  {
    "id": "chg_temp",
    "type": "change",
    "z": "flow_tab_sensors",
    "name": "TEMP-01: показание",
    "rules": [
      {
        "t": "set",
        "p": "reading.value",
        "pt": "msg",
        "to": "payload",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "reading.sensor_id",
        "pt": "msg",
        "to": "TEMP-01",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "reading.zone",
        "pt": "msg",
        "to": "server_room",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "reading.timestamp",
        "pt": "msg",
        "to": "timestamp",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "reading.unit",
        "pt": "msg",
        "to": "C",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "reading",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "headers",
        "pt": "msg",
        "to": "{\"Content-Type\":\"application/json\"}",
        "tot": "json"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 480,
    "y": 100,
    "wires": [
      [
        "http_temp",
        "db_temp"
      ]
    ]
  },
