  {
    "id": "sw_fan",
    "type": "switch",
    "z": "flow_tab_sensors",
    "name": "Температура > 30 °C",
    "property": "payload",
    "propertyType": "msg",
    "rules": [
      {
        "t": "gt",
        "v": "30",
        "vt": "num"
      },
      {
        "t": "else"
      }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 2,
    "x": 480,
    "y": 300,
    "wires": [
      [
        "chg_fan_on"
      ],
      [
        "chg_fan_off"
      ]
    ]
  },
  {
