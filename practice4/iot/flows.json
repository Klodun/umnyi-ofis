  {
    "id": "fan_tab",
    "type": "tab",
    "label": "Вентилятор FAN-01",
    "disabled": false,
    "info": "Задание №5. Температура задаётся в узле inject «Температура, °C»: двойной клик, вписать число, Done, Deploy, затем нажать квадратик слева от узла. Switch сравнивает значение с порогом 30 °C, для каждого состояния свой change собирает fan.state/actuator_id/zone/mode и отправляет POST на /api/actuators."
  },
  {
    "id": "sw_fan",
    "type": "switch",
    "z": "fan_tab",
    "name": "Температура > 30 °C",
    "property": "payload",
    "propertyType": "msg",
    "rules": [
      {
        "t": "gt",
        "v": "30",
        "vt": "num"
      },
      {
        "t": "else"
      }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 2,
    "x": 500,
    "y": 180,
    "wires": [
      [
        "chg_fan_on"
      ],
      [
        "chg_fan_off"
      ]
    ]
  },
  {
    "id": "chg_fan_on",
    "type": "change",
    "z": "fan_tab",
    "name": "Включить вентилятор (ON)",
    "rules": [
      {
        "t": "set",
        "p": "fan.state",
        "pt": "msg",
        "to": "ON",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "fan.actuator_id",
        "pt": "msg",
        "to": "FAN-01",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "fan.zone",
        "pt": "msg",
        "to": "server_room",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "fan.mode",
        "pt": "msg",
        "to": "auto",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "fan.timestamp",
        "pt": "msg",
        "to": "$millis()",
        "tot": "jsonata"
      },
      {
        "t": "set",
        "p": "human",
        "pt": "msg",
        "to": "ВЕНТИЛЯТОР ВКЛЮЧЁН (ON)",
        "tot": "str"
      },
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "fan",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "headers",
        "pt": "msg",
        "to": "{\"Content-Type\":\"application/json\"}",
        "tot": "json"
      }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 800,
    "y": 120,
    "wires": [
      [
        "http_fan",
        "dbg_fan_state"
      ]
    ]
  },
  {
    "id": "chg_fan_off",
    "type": "change",
    "z": "fan_tab",
    "name": "Выключить вентилятор (OFF)",
    "rules": [
      {
        "t": "set",
        "p": "fan.state",
        "pt": "msg",
        "to": "OFF",
        "tot": "str"
      },
      {
